---
import '../styles/global.css';
import { profile, experience, projects } from '../data/site';
import { githubActivity } from '../data/githubActivity';
import { slug } from '../data/slug';
const { title = profile.name, description = profile.summary.slice(0, 155) } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Cloudflare Web Analytics loads only when a site token is set at build time.
const analyticsToken = import.meta.env.PUBLIC_ANALYTICS_TOKEN;
// The chat widget is part of the optional backend: it renders only when a backend URL is set at build time.
const chatEnabled = Boolean(import.meta.env.PUBLIC_API_URL);
const firstName = profile.name.split(' ')[0];
const chatChips = ['What does Nathan work on at Microsoft?', "What's his tech stack?", 'Tell me about Atlas', 'How can I contact him?'];
const sections = ['skills', 'experience', 'projects', 'activity', 'contact'];
// Extra palette entries: companies/schools, work projects, and GitHub repos.
const repos = new Map<string, { name: string; hint: string; href: string }>();
for (const p of projects) repos.set(p.href.toLowerCase(), { name: p.name, hint: p.blurb, href: p.href });
for (const r of githubActivity.repos) if (!repos.has(r.url.toLowerCase())) repos.set(r.url.toLowerCase(), { name: r.name, hint: r.description, href: r.url });
const searchItems = [
  ...experience.flatMap((e) => [
    { kind: 'goto', name: e.org.split(' · ')[0], hint: `${e.role} · ${e.period}`, target: `job-${slug(e.org)}` },
    ...(e.projects ?? []).map((p) => ({ kind: 'goto', name: p.name, hint: `${e.org.split(' · ')[0]} project: ${p.hook}`, target: `proj-${slug(p.name)}` })),
  ]),
  ...[...repos.values()].map((r) => ({ kind: 'open', name: r.name, hint: `repo: ${r.hint}`, target: r.href })),
];
const commands = JSON.stringify({
  apiUrl: import.meta.env.PUBLIC_API_URL ?? '',
  sections,
  links: profile.links,
  email: profile.email,
  summary: profile.summary,
  name: profile.name,
  role: profile.role,
  items: searchItems,
});
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {analyticsToken && (
      <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>
    )}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="min-h-screen">
    <div class="grid-bg" aria-hidden="true"></div>
    <header class="sticky top-0 z-30 backdrop-blur border-b border-border/60 bg-bg/70">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3" aria-label="Main">
        <a href="#top" class="font-mono text-sm font-semibold"><span class="accent-text">~/nathancj</span></a>
        <ul class="hidden gap-5 text-sm text-muted md:flex">
          {sections.slice(0, 4).map((s) => <li><a class="hover:text-fg capitalize" href={`#${s}`}>{s}</a></li>)}
        </ul>
        <div class="flex items-center gap-2">
          <button id="open-palette" class="flex items-center gap-2 rounded-md border border-border px-2.5 py-1 font-mono text-xs text-muted hover:text-fg" aria-label="Open command palette">
            <span>Search</span><kbd class="hidden rounded bg-surface px-1.5 py-0.5 sm:inline">⌘K</kbd>
          </button>
          <button id="toggle-theme" class="rounded-md border border-border px-2.5 py-1 text-xs text-muted hover:text-fg" aria-label="Toggle light/dark theme">Theme</button>
          <button id="menu-toggle" class="rounded-md border border-border px-2.5 py-1 text-xs text-muted hover:text-fg md:hidden" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg viewBox="0 0 20 20" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path id="menu-icon" d="M3 5h14M3 10h14M3 15h14"/></svg>
          </button>
        </div>
      </nav>
      <ul id="mobile-menu" class="mx-auto hidden max-w-5xl border-t border-border/60 px-4 py-2 text-sm md:hidden">
        {sections.map((s) => <li><a class="block py-2 capitalize text-muted hover:text-fg" href={`#${s}`}>{s}</a></li>)}
      </ul>
    </header>

    <slot />

    <footer class="mx-auto max-w-5xl px-4 py-10 text-center font-mono text-xs text-muted">
      © {new Date().getFullYear()} {profile.name} · built with Astro · press <kbd class="rounded border border-border px-1">`</kbd> for a terminal
      <span id="view-counter" class="mt-3 flex flex-wrap items-center justify-center gap-2" aria-label="Site views" hidden></span>
      {analyticsToken && <span class="mt-1 block">Anonymous, cookie-free page-view analytics by Cloudflare.</span>}
    </footer>

    <!-- Command palette -->
    <div id="palette" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/60 p-4 pt-[15vh]" role="dialog" aria-modal="true" aria-label="Command palette">
      <div class="card w-full max-w-lg overflow-hidden !transform-none">
        <input id="palette-input" class="w-full border-b border-border bg-transparent px-4 py-3 font-mono text-sm outline-none" placeholder="Type a command or section…" autocomplete="off" spellcheck="false" />
        <ul id="palette-list" class="max-h-72 overflow-auto py-1 text-sm" role="listbox"></ul>
      </div>
    </div>

    <!-- Mini terminal -->
    <div id="terminal" class="fixed bottom-4 right-4 z-40 hidden w-[min(92vw,34rem)] overflow-hidden rounded-xl border border-border bg-surface shadow-2xl" role="dialog" aria-label="Terminal">
      <div class="flex items-center justify-between border-b border-border px-3 py-2 font-mono text-xs text-muted">
        <span>nathan@site: ~</span>
        <button id="terminal-close" aria-label="Close terminal" class="hover:text-fg">✕</button>
      </div>
      <div id="term-out" class="h-64 overflow-auto px-3 py-2 font-mono text-xs leading-relaxed" aria-live="polite"></div>
      <form id="term-form" class="flex items-center gap-2 border-t border-border px-3 py-2 font-mono text-xs">
        <span class="accent-text">$</span>
        <input id="term-input" class="flex-1 bg-transparent outline-none" autocomplete="off" spellcheck="false" aria-label="Terminal input" />
      </form>
    </div>

    {chatEnabled && (
      <>
        <!-- Chat launcher + panel (backend-powered; see src/scripts/chat.ts) -->
        <button id="chat-launcher" type="button" class="ai-border fixed bottom-4 right-4 z-30 flex items-center gap-2.5 rounded-full px-5 py-3 font-mono text-sm font-semibold shadow-lg" aria-haspopup="dialog" aria-controls="chat">
          <span class="accent-text text-2xl leading-none" aria-hidden="true">✦</span> Ask AI
        </button>
        <div id="chat" class="fixed inset-x-2 bottom-2 z-40 hidden h-[min(34rem,80dvh)] flex-col overflow-hidden rounded-xl border border-border bg-surface shadow-2xl sm:inset-x-auto sm:bottom-4 sm:right-4 sm:w-[min(92vw,26rem)] sm:max-h-[70vh]" role="dialog" aria-label={`Ask about ${firstName}`}>
          <div class="flex items-center justify-between gap-2 border-b border-border px-3 py-2 font-mono text-xs">
            <div class="flex min-w-0 items-center gap-2">
              <span class="truncate font-semibold">Ask about {firstName}</span>            </div>
            <div class="flex shrink-0 items-center gap-3 text-muted">
              <button id="chat-clear" type="button" class="hidden hover:text-fg" aria-label="Clear chat">Clear</button>
              <button id="chat-close" type="button" class="hover:text-fg" aria-label="Close chat">✕</button>
            </div>
          </div>
          <div id="chat-log" role="log" aria-live="polite" aria-relevant="additions text" class="flex-1 space-y-3 overflow-auto px-3 py-3 text-sm">
            <div id="chat-empty">
              <p class="text-sm text-muted">Hi! I'm an AI that answers questions about {firstName}'s background. Try one of these:</p>
              <div class="mt-3 flex flex-col items-start gap-2">
                {chatChips.map((q) => <button type="button" class="chat-chip" data-q={q}>{q}</button>)}
              </div>
            </div>
          </div>
          <div id="chat-notice" class="chat-notice hidden" role="alert"></div>
          <form id="chat-form" class="flex items-end gap-2 border-t border-border px-3 py-2">
            <div class="relative min-w-0 flex-1">
              <textarea id="chat-input" rows="1" maxlength="500" class="block max-h-28 w-full resize-none rounded-md border border-border bg-bg px-2.5 py-1.5 text-base outline-none focus:border-accent sm:text-sm disabled:opacity-60" placeholder="Ask a question…" aria-label="Your question" autocomplete="off"></textarea>
              <span id="chat-count" class="pointer-events-none absolute -top-4 right-1 hidden font-mono text-[0.65rem] text-muted" aria-hidden="true"></span>
            </div>
            <button id="chat-send" type="submit" class="btn-solid shrink-0 rounded-md px-3 py-1.5 text-sm font-semibold disabled:opacity-50">Send</button>
          </form>
          <p class="border-t border-border px-3 py-2 text-[0.65rem] leading-snug text-muted">
            AI answers come only from this site's content and can be wrong. Conversations are logged. Powered by Cloudflare Workers AI.
            <span id="chat-left" class="mt-0.5 block font-mono"></span>
          </p>
        </div>
      </>
    )}

    <script id="cmd-data" type="application/json" set:html={commands}></script>
    <script>
      import '../scripts/ui';
      import '../scripts/chat';
    </script>
  </body>
</html>
