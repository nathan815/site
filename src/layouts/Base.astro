---
import '../styles/global.css';
import { profile } from '../data/site';
const { title = `${profile.name} — ${profile.role}`, description = profile.summary.slice(0, 155) } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const sections = ['skills', 'experience', 'projects', 'activity', 'contact'];
const commands = JSON.stringify({
  sections,
  links: profile.links,
  email: profile.email,
  summary: profile.summary,
  name: profile.name,
  role: profile.role,
});
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body class="min-h-screen">
    <div class="grid-bg" aria-hidden="true"></div>
    <header class="sticky top-0 z-30 backdrop-blur border-b border-border/60 bg-bg/70">
      <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3" aria-label="Main">
        <a href="#top" class="font-mono text-sm font-semibold"><span class="accent-text">~/nathancj</span></a>
        <ul class="hidden gap-5 text-sm text-muted md:flex">
          {sections.slice(0, 4).map((s) => <li><a class="hover:text-fg capitalize" href={`#${s}`}>{s}</a></li>)}
        </ul>
        <div class="flex items-center gap-2">
          <button id="open-palette" class="hidden items-center gap-2 rounded-md border border-border px-2.5 py-1 font-mono text-xs text-muted hover:text-fg sm:flex" aria-label="Open command palette">
            <span>Search</span><kbd class="rounded bg-surface px-1.5 py-0.5">⌘K</kbd>
          </button>
          <button id="toggle-theme" class="rounded-md border border-border px-2.5 py-1 text-xs text-muted hover:text-fg" aria-label="Toggle light/dark theme">Theme</button>
        </div>
      </nav>
    </header>

    <slot />

    <footer class="mx-auto max-w-5xl px-4 py-10 text-center font-mono text-xs text-muted">
      © {new Date().getFullYear()} {profile.name} · built with Astro · press <kbd class="rounded border border-border px-1">`</kbd> for a terminal
    </footer>

    <!-- Command palette -->
    <div id="palette" class="fixed inset-0 z-50 hidden items-start justify-center bg-black/60 p-4 pt-[15vh]" role="dialog" aria-modal="true" aria-label="Command palette">
      <div class="card w-full max-w-lg overflow-hidden !transform-none">
        <input id="palette-input" class="w-full border-b border-border bg-transparent px-4 py-3 font-mono text-sm outline-none" placeholder="Type a command or section…" autocomplete="off" spellcheck="false" />
        <ul id="palette-list" class="max-h-72 overflow-auto py-1 text-sm" role="listbox"></ul>
      </div>
    </div>

    <!-- Mini terminal -->
    <div id="terminal" class="fixed bottom-4 right-4 z-40 hidden w-[min(92vw,34rem)] overflow-hidden rounded-xl border border-border bg-surface shadow-2xl" role="dialog" aria-label="Terminal">
      <div class="flex items-center justify-between border-b border-border px-3 py-2 font-mono text-xs text-muted">
        <span>nathan@site: ~</span>
        <button id="terminal-close" aria-label="Close terminal" class="hover:text-fg">✕</button>
      </div>
      <div id="term-out" class="h-64 overflow-auto px-3 py-2 font-mono text-xs leading-relaxed" aria-live="polite"></div>
      <form id="term-form" class="flex items-center gap-2 border-t border-border px-3 py-2 font-mono text-xs">
        <span class="accent-text">$</span>
        <input id="term-input" class="flex-1 bg-transparent outline-none" autocomplete="off" spellcheck="false" aria-label="Terminal input" />
      </form>
    </div>

    <script id="cmd-data" type="application/json" set:html={commands}></script>
    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
